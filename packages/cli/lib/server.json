    {
      "name": "get_schema",
      "description": "One schema's accepted draft: its name, summary, contract and parameters; its items listed with their id, kind, title and description but not their content; every link between them; and the schemas it embeds, each collapsed to its name, summary, contract and pinned draft, saying if a newer draft exists. Fetch an item with get_schema_item. Open further levels with depth, or by calling this for an embedded schema's id and draft. proposal says if a change is waiting for the user.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "schema_id": {
            "type": "string"
          },
          "draft_id": {
            "description": "The draft to read (default: the latest)",
            "type": "string"
          },
          "depth": {
            "description": "How many levels of embedded schemas to open (default 0: all collapsed)",
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "schema_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
