        "type": "object",
        "properties": {
          "window_id": {
            "type": "string",
            "description": "The window named in the prompt, such as w-7f3a"
          }
        },
        "required": [
          "window_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
